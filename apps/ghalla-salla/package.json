{
  "name": "@ghalla/salla",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Salla integration: adapter, webhooks, dashboard API. Its own service, its own database.",
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/main.js",
    "dev": "node --watch --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ghalla/contracts": "workspace:*",
    "@ghalla/core": "workspace:*",
    "@ghalla/persistence": "workspace:*",
    "@ghalla/ports": "workspace:*",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "nestjs-pino": "5.1.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@ghalla/tsconfig": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
