{
  "name": "@ghalla/schemas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Runtime validation for the canonical types. Kept out of @ghalla/contracts so zod never enters the pure engine's dependency graph.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@ghalla/contracts": "workspace:*",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@ghalla/tsconfig": "workspace:*",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
