{
  "name": "@ghalla/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The profit engine. Pure: no I/O, no clock, no randomness.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
