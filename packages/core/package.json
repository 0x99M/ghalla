  },
  "//dependencies": "Exactly one. Adding a second is an architecture decision, not a chore.",
  "dependencies": {
    "@ghalla/contracts": "workspace:*"
  },
  "devDependencies": {
    "@ghalla/tsconfig": "workspace:*",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
