{
  "name": "ghalla",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "description": "Profit analytics for e-commerce merchants \u2014 know your real profit.",
  "engines": {
    "node": ">=22.13"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.14.0",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b tsconfig.json && turbo run typecheck",
    "lint": "eslint . --max-warnings=0",
    "arch": "pnpm run arch:vocab && pnpm run arch:graph && ./scripts/check-calc-version.sh",
    "arch:graph": "depcruise --config .dependency-cruiser.mjs packages apps tooling",
    "arch:vocab": "./scripts/no-platform-vocab.sh",
    "check:migrations": "./scripts/check-migrations.sh",
    "verify": "pnpm run arch:vocab && pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run arch:graph",
    "clean": "turbo run clean && rm -rf node_modules/.cache .turbo",
    "dev:api": "pnpm --filter @ghalla/salla dev",
    "start:api": "pnpm --filter @ghalla/salla start",
    "db:generate": "pnpm --filter @ghalla/persistence db:generate",
    "db:migrate": "pnpm --filter @ghalla/persistence db:migrate",
    "db:push": "pnpm --filter @ghalla/persistence db:push",
    "db:studio": "pnpm --filter @ghalla/persistence db:studio",
    "db:clear": "pnpm --filter @ghalla/persistence build && node packages/persistence/dist/db/clear.js",
    "db:seed": "pnpm --filter @ghalla/persistence build && node packages/persistence/dist/db/seeds/demo-store.js",
    "db:reset": "pnpm run db:clear && pnpm run migrate:deploy && pnpm run db:seed",
    "migrate:deploy": "pnpm --filter @ghalla/persistence migrate:deploy",
    "release:check": "./scripts/release.sh check",
    "release:staging": "./scripts/release.sh all",
    "verify:staging": "./scripts/release.sh verify",
    "db:reset:staging": "GHALLA_ALLOW_DESTRUCTIVE=1 pnpm run db:reset"
  },
  "devDependencies": {
    "@ghalla/eslint-config": "workspace:*",
    "@ghalla/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "5.0.0",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.10.0",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
